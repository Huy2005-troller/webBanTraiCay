@model Fruitables.ViewModels.ForgotPasswordRequest
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast show" role="alert" data-bs-autohide="true" data-bs-delay="8000">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
    {
        <div class="toast show" role="alert" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-danger text-white">
                <i class="fas fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        </div>
    }
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="auth-card p-4">
                <div class="text-center mb-4">
                    <h1 class="h3 text-primary fw-bold">
                        <i class="fas fa-leaf me-2"></i>Fruitables
                    </h1>
                    <p class="text-muted">Đặt lại mật khẩu của bạn</p>
                </div>

                <!-- Tabs chọn phương thức -->
                <ul class="nav nav-pills nav-justified mb-4" id="resetMethodTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="phone-tab" data-bs-toggle="pill" data-bs-target="#phone-method" type="button" role="tab">
                            <i class="fas fa-phone me-1"></i>SĐT + Email
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="email-tab" data-bs-toggle="pill" data-bs-target="#email-method" type="button" role="tab">
                            <i class="fas fa-envelope me-1"></i>Gửi qua Email
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="resetMethodContent">
                    <!-- Phương thức 1: Email + SĐT (hiện tại) -->
                    <div class="tab-pane fade show active" id="phone-method" role="tabpanel">
                        <p class="text-muted small mb-3">Nhập email và số điện thoại đã đăng ký để đặt lại mật khẩu trực tiếp.</p>
                        <form asp-action="ForgotPassword" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">
                                    <i class="fas fa-envelope me-1"></i>Email
                                </label>
                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="email@example.com"
                                       autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Phone" class="form-label">
                                    <i class="fas fa-phone me-1"></i>Số điện thoại
                                </label>
                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="Nhập số điện thoại (10-11 số)"
                                       autocomplete="tel" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-auth-primary">
                                    <i class="fas fa-arrow-right me-2"></i>Tiếp tục
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Phương thức 2: Gửi mật khẩu tạm qua Email -->
                    <div class="tab-pane fade" id="email-method" role="tabpanel">
                        <p class="text-muted small mb-3">Nhập email đã đăng ký, hệ thống sẽ gửi mật khẩu tạm thời đến hộp thư của bạn.</p>
                        <form asp-action="ForgotPasswordEmail" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-4">
                                <label class="form-label">
                                    <i class="fas fa-envelope me-1"></i>Email
                                </label>
                                <input type="email" name="Email"
                                       class="form-control"
                                       placeholder="email@example.com"
                                       required
                                       autocomplete="email" />
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-warning text-white">
                                    <i class="fas fa-paper-plane me-2"></i>Gửi mật khẩu qua Email
                                </button>
                            </div>

                            <div class="alert alert-info mt-3 small mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                Mật khẩu tạm thời có hiệu lực trong <strong>15 phút</strong>. Sau khi đăng nhập, hãy đổi mật khẩu mới ngay.
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <p class="mb-2">Nhớ mật khẩu rồi? <a asp-action="Login" class="text-primary fw-bold">Đăng nhập</a></p>
                </div>

                <div class="text-center mt-3">
                    <a href="/" class="text-muted text-decoration-none">
                        <i class="fas fa-arrow-left me-1"></i>Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            document.querySelectorAll('.toast.show').forEach(function(toast) {
                setTimeout(function() {
                    var bsToast = bootstrap.Toast.getOrCreateInstance(toast);
                    bsToast.hide();
                }, 8000);
            });
        })();
    </script>
}
