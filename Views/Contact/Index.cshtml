@{
    ViewData["Title"] = "Contact";
    var chatConversationId = (int)(ViewBag.ChatConversationId ?? 0);
    var chatCustomerName = (string)(ViewBag.ChatCustomerName ?? "");
    var chatCustomerPhone = (string)(ViewBag.ChatCustomerPhone ?? "");
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@section Styles {
    <style>
        .contact-chat-panel {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
            background: #fff;
        }

        .contact-chat-header {
            background: #81c408;
            color: #fff;
            padding: 14px 18px;
        }

        .contact-chat-messages {
            height: 320px;
            overflow-y: auto;
            padding: 16px;
            background: #f8fafc;
        }

        .contact-chat-message {
            max-width: 78%;
            margin-bottom: 12px;
            padding: 10px 12px;
            border-radius: 8px;
            line-height: 1.45;
            word-break: break-word;
        }

        .contact-chat-message.customer {
            margin-left: auto;
            background: #81c408;
            color: #fff;
        }

        .contact-chat-message.admin {
            margin-right: auto;
            background: #fff;
            color: #334155;
            border: 1px solid #e5e7eb;
        }

        .contact-chat-time {
            display: block;
            font-size: 0.72rem;
            opacity: 0.75;
            margin-top: 4px;
        }
    </style>
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Contact</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active text-white">Contact</li>
    </ol>
</div>
<!-- Single Page Header End -->

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    @if (TempData["Success"] != null)
    {
        <div class="toast show" role="alert" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-success text-white">
                <i class="fa fa-check-circle me-2"></i>
                <strong class="me-auto">Thành công</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast show" role="alert" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-danger text-white">
                <i class="fa fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@TempData["Error"]</div>
        </div>
    }
</div>

<!-- Contact Start -->
<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="row g-4">
                <div class="col-12">
                    <div class="text-center mx-auto" style="max-width: 700px;">
                        <h1 class="text-primary">Get in touch</h1>
                        <p class="mb-4">The contact form is currently inactive. Get a functional and working contact form with Ajax & PHP in a few minutes.</p>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="h-100 rounded">
                        <iframe class="rounded w-100" style="height: 400px;" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d387191.33750346623!2d-73.97968099999999!3d40.6974881!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew%20York%2C%20NY%2C%20USA!5e0!3m2!1sen!2sbd!4v1694259649153!5m2!1sen!2sbd" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
                <div class="col-lg-7">
                    <form asp-controller="Contact" asp-action="SendMessage" method="post">
                        @Html.AntiForgeryToken()
                        <input type="text" name="name" class="w-100 form-control border-0 py-3 mb-4" placeholder="Your Name" required>
                        <input type="email" name="email" class="w-100 form-control border-0 py-3 mb-4" placeholder="Enter Your Email" required>
                        <textarea name="message" class="w-100 form-control border-0 mb-4" rows="5" cols="10" placeholder="Your Message" required></textarea>
                        <button type="submit" class="w-100 btn form-control border-secondary py-3 bg-white text-primary">Submit</button>
                    </form>
                </div>
                <div class="col-lg-5">
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-map-marker-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Address</h4>
                            <p class="mb-2">123 Street New York, USA</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-envelope fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Mail Us</h4>
                            <p class="mb-2">info@example.com</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded bg-white">
                        <i class="fa fa-phone-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Telephone</h4>
                            <p class="mb-2">(+012) 3456 7890</p>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="contact-chat-panel">
                        <div class="contact-chat-header d-flex align-items-center justify-content-between">
                            <div>
                                <h4 class="text-white mb-1">Chat với Admin</h4>
                                <small>Hỗ trợ nhanh cho khách hàng và khách vãng lai</small>
                            </div>
                            <i class="fas fa-comments fa-2x"></i>
                        </div>
                        <div class="p-3">
                            <div id="contactChatIdentity" class="row g-3 mb-3 @(isAuthenticated ? "d-none" : "")">
                                <div class="col-md-5">
                                    <input id="contactChatName" type="text" class="form-control" placeholder="Tên của bạn" value="@chatCustomerName">
                                </div>
                                <div class="col-md-5">
                                    <input id="contactChatPhone" type="tel" class="form-control" placeholder="Số điện thoại" value="@chatCustomerPhone">
                                </div>
                                <div class="col-md-2 d-grid">
                                    <button id="contactChatStartBtn" type="button" class="btn btn-primary">Bắt đầu</button>
                                </div>
                            </div>
                            @if (isAuthenticated)
                            {
                                <div class="alert alert-light border d-flex align-items-center justify-content-between mb-3">
                                    <span><strong>@chatCustomerName</strong> - @chatCustomerPhone</span>
                                    <span class="badge bg-success">Đã đăng nhập</span>
                                </div>
                            }
                            <div id="contactChatMessages" class="contact-chat-messages">
                                <div class="text-center text-muted py-5">Bắt đầu cuộc chat để gửi tin nhắn cho Admin.</div>
                            </div>
                            <form id="contactChatForm" class="d-flex gap-2 mt-3">
                                <input id="contactChatMessage" type="text" class="form-control" placeholder="Nhập tin nhắn..." autocomplete="off" disabled>
                                <button id="contactChatSendBtn" type="submit" class="btn btn-primary" disabled>
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Contact End -->


@section Scripts {
    <script>
        (function() {
            document.querySelectorAll('.toast.show').forEach(function(toast) {
                setTimeout(function() {
                    var bsToast = bootstrap.Toast.getOrCreateInstance(toast);
                    bsToast.hide();
                }, 5000);
            });
        })();
    </script>
    <script>
        (function () {
            const initialConversationId = @chatConversationId;
            const isAuthenticated = @(isAuthenticated ? "true" : "false");
            const authenticatedName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chatCustomerName));
            const authenticatedPhone = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chatCustomerPhone));
            let conversationId = initialConversationId > 0 ? initialConversationId : null;
            const renderedMessageIds = new Set();

            const identity = document.getElementById('contactChatIdentity');
            const nameInput = document.getElementById('contactChatName');
            const phoneInput = document.getElementById('contactChatPhone');
            const startBtn = document.getElementById('contactChatStartBtn');
            const messagesEl = document.getElementById('contactChatMessages');
            const form = document.getElementById('contactChatForm');
            const messageInput = document.getElementById('contactChatMessage');
            const sendBtn = document.getElementById('contactChatSendBtn');

            function setChatReady(ready) {
                messageInput.disabled = !ready;
                sendBtn.disabled = !ready;
                if (ready) {
                    identity?.classList.add('d-none');
                    messageInput.focus();
                }
            }

            function formatTime(value) {
                return new Date(value).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
            }

            function clearEmptyState() {
                if (messagesEl.querySelector('.text-center')) {
                    messagesEl.innerHTML = '';
                }
            }

            function appendMessage(message) {
                if (!message || renderedMessageIds.has(message.id)) return;
                renderedMessageIds.add(message.id);
                clearEmptyState();

                const sender = (message.senderType || '').toLowerCase() === 'admin' ? 'admin' : 'customer';
                const item = document.createElement('div');
                item.className = `contact-chat-message ${sender}`;
                item.innerHTML = `
                    <div>${escapeHtml(message.message)}</div>
                    <span class="contact-chat-time">${formatTime(message.createdAt)}</span>
                `;
                messagesEl.appendChild(item);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            function escapeHtml(value) {
                const div = document.createElement('div');
                div.textContent = value || '';
                return div.innerHTML;
            }

            async function ensureHub() {
                if (!window.ecommerceHubReady) throw new Error('SignalR chưa sẵn sàng.');
                await window.ecommerceHubReady;
            }

            async function loadMessages() {
                if (!conversationId) return;
                await ensureHub();
                const messages = await window.ecommerceHub.invoke('GetCustomerMessages', conversationId);
                messagesEl.innerHTML = '';
                renderedMessageIds.clear();
                if (!messages.length) {
                    messagesEl.innerHTML = '<div class="text-center text-muted py-5">Bạn có thể gửi tin nhắn đầu tiên cho Admin.</div>';
                }
                messages.forEach(appendMessage);
            }

            async function startChat() {
                const name = (nameInput?.value || '').trim();
                const phone = (phoneInput?.value || '').trim();

                if (!isAuthenticated && (!name || !phone)) {
                    alert('Vui lòng nhập tên và số điện thoại.');
                    return;
                }

                await ensureHub();
                const conversation = await window.ecommerceHub.invoke('StartContactChat', name || authenticatedName, phone || authenticatedPhone);
                conversationId = conversation.id;
                setChatReady(true);
                await loadMessages();
            }

            startBtn?.addEventListener('click', function () {
                startChat().catch(err => alert(err.message || err.toString()));
            });

            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                const message = messageInput.value.trim();
                if (!message) return;

                try {
                    if (!conversationId) {
                        await startChat();
                    }
                    await ensureHub();
                    await window.ecommerceHub.invoke('SendCustomerMessage', conversationId, message);
                    messageInput.value = '';
                } catch (err) {
                    alert(err.message || err.toString());
                }
            });

            if (window.ecommerceHub) {
                window.ecommerceHub.on('ContactChatMessageReceived', function (message) {
                    if (!conversationId || message.conversationId !== conversationId) return;
                    appendMessage(message);
                    window.ecommerceHub.invoke('MarkConversationRead', conversationId).catch(function () {});
                });
            }

            if (conversationId) {
                setChatReady(true);
                loadMessages().catch(function (err) {
                    console.error(err);
                });
            }
        })();
    </script>
}
