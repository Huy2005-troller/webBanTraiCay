@model Fruitables.ViewModels.OrderDetailViewModel
@using Fruitables.Models
@{
    ViewData["Title"] = $"Chi tiết đơn hàng {Model.OrderNumber}";
    var phone = ViewBag.Phone as string ?? string.Empty;

    var statusClass = Model.Status switch {
        OrderStatus.Pending    => "bg-warning",
        OrderStatus.Processing => "bg-info",
        OrderStatus.Shipped    => "bg-primary",
        OrderStatus.Delivered  => "bg-success",
        OrderStatus.Cancelled  => "bg-danger",
        OrderStatus.Returned   => "bg-secondary",
        _ => "bg-secondary"
    };
    var statusText = Model.Status switch {
        OrderStatus.Pending    => "Chờ xử lý",
        OrderStatus.Processing => "Đang xử lý",
        OrderStatus.Shipped    => "Đang giao",
        OrderStatus.Delivered  => "Đã giao",
        OrderStatus.Cancelled  => "Đã hủy",
        OrderStatus.Returned   => "Trả hàng",
        _ => "Không xác định"
    };
}

<!-- Page Header -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Chi tiết đơn hàng</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Lookup">Tra cứu đơn hàng</a></li>
        <li class="breadcrumb-item active text-white">@Model.OrderNumber</li>
    </ol>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast show" role="alert" data-bs-autohide="true" data-bs-delay="5000">
            <div class="toast-header bg-danger text-white">
                <i class="fa fa-exclamation-circle me-2"></i>
                <strong class="me-auto">Lỗi</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@TempData["ErrorMessage"]</div>
        </div>
    }
</div>

<!-- Guest Notice Banner -->
<div class="container-fluid py-2" style="background: linear-gradient(90deg,#f0fdf4,#dcfce7); border-bottom: 1px solid #bbf7d0;">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <small class="text-success">
                <i class="fas fa-search me-1"></i>
                Đang xem với tư cách khách — tra cứu bằng SĐT
                <strong>@phone.Substring(0, Math.Min(3, phone.Length))****@(phone.Length > 7 ? phone.Substring(7) : "")</strong>
            </small>
            <a asp-action="Lookup" class="btn btn-sm btn-outline-success" style="border-radius: 8px;">
                <i class="fas fa-arrow-left me-1"></i> Tra cứu đơn khác
            </a>
        </div>
    </div>
</div>

<!-- Order Details -->
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="row">
            <!-- Left Column: Order Info -->
            <div class="col-lg-8">
                <!-- Order Header Card -->
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; overflow: hidden;">
                    <div style="height: 4px; background: linear-gradient(90deg,#81c408,#5a8a06);"></div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h4 class="mb-1 fw-bold">Đơn hàng @Model.OrderNumber</h4>
                                <p class="text-muted mb-0">
                                    <i class="fa fa-calendar me-2"></i>Đặt ngày @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                            <span class="badge @statusClass fs-6">@statusText</span>
                        </div>

                        @if (Model.Status == OrderStatus.Delivered && Model.DeliveredAt.HasValue)
                        {
                            <div class="alert alert-success mt-3 mb-0">
                                <i class="fa fa-check-circle me-2"></i>
                                Đơn hàng đã được giao thành công vào ngày @Model.DeliveredAt.Value.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }

                        @if (Model.Status == OrderStatus.Cancelled && !string.IsNullOrEmpty(Model.CancelReason))
                        {
                            <div class="alert alert-danger mt-3 mb-0">
                                <i class="fa fa-times-circle me-2"></i>
                                <strong>Lý do hủy:</strong> @Model.CancelReason
                            </div>
                        }
                    </div>
                </div>

                <!-- Status Timeline -->
                @if (Model.StatusHistory.Any())
                {
                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; overflow: hidden;">
                        <div style="height: 4px; background: linear-gradient(90deg,#81c408,#5a8a06);"></div>
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0 fw-bold">
                                <i class="fa fa-history me-2 text-success"></i>Lịch sử trạng thái
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="timeline">
                                @foreach (var history in Model.StatusHistory)
                                {
                                    var hClass = history.NewStatus switch {
                                        OrderStatus.Pending    => "warning",
                                        OrderStatus.Processing => "info",
                                        OrderStatus.Shipped    => "primary",
                                        OrderStatus.Delivered  => "success",
                                        OrderStatus.Cancelled  => "danger",
                                        OrderStatus.Returned   => "secondary",
                                        _ => "secondary"
                                    };
                                    var hText = history.NewStatus switch {
                                        OrderStatus.Pending    => "Chờ xử lý",
                                        OrderStatus.Processing => "Đang xử lý",
                                        OrderStatus.Shipped    => "Đang giao",
                                        OrderStatus.Delivered  => "Đã giao",
                                        OrderStatus.Cancelled  => "Đã hủy",
                                        OrderStatus.Returned   => "Trả hàng",
                                        _ => "Không xác định"
                                    };
                                    var hIcon = history.NewStatus switch {
                                        OrderStatus.Pending    => "fa-clock",
                                        OrderStatus.Processing => "fa-cog",
                                        OrderStatus.Shipped    => "fa-truck",
                                        OrderStatus.Delivered  => "fa-check-circle",
                                        OrderStatus.Cancelled  => "fa-times-circle",
                                        OrderStatus.Returned   => "fa-undo",
                                        _ => "fa-circle"
                                    };
                                    <div class="d-flex mb-3">
                                        <div class="flex-shrink-0">
                                            <span class="badge bg-@hClass rounded-circle p-2">
                                                <i class="fa @hIcon"></i>
                                            </span>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h6 class="mb-1 fw-semibold">@hText</h6>
                                            <p class="text-muted small mb-0">
                                                @history.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                @if (!string.IsNullOrEmpty(history.Notes))
                                                {
                                                    <span> — @history.Notes</span>
                                                }
                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Products -->
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; overflow: hidden;">
                    <div style="height: 4px; background: linear-gradient(90deg,#81c408,#5a8a06);"></div>
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="fa fa-shopping-cart me-2 text-success"></i>Sản phẩm (@Model.Items.Count)
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">Đơn giá</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                                    {
                                                        <img src="@item.ProductImage" alt="@item.ProductName"
                                                             class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                                             style="width: 60px; height: 60px;">
                                                            <i class="fa fa-image text-muted"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <h6 class="mb-0">@item.ProductName</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">@item.Price.ToString("N0")₫</td>
                                            <td class="text-center align-middle">@item.Quantity</td>
                                            <td class="text-end align-middle fw-bold">@item.Total.ToString("N0")₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Summary -->
            <div class="col-lg-4">
                <!-- Payment Info -->
                <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; overflow: hidden;">
                    <div style="height: 4px; background: linear-gradient(90deg,#81c408,#5a8a06);"></div>
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="fa fa-credit-card me-2 text-success"></i>Thanh toán</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span>@Model.Subtotal.ToString("N0")₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span>@Model.ShippingFee.ToString("N0")₫</span>
                        </div>
                        @if (Model.Discount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Giảm giá:</span>
                                <span>-@Model.Discount.ToString("N0")₫</span>
                            </div>
                        }
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Tổng cộng:</strong>
                            <strong class="text-success fs-5">@Model.Total.ToString("N0")₫</strong>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phương thức:</span>
                            <span class="fw-semibold">
                                @(Model.PaymentMethod switch {
                                    PaymentMethod.COD          => "Thanh toán khi nhận hàng",
                                    PaymentMethod.BankTransfer => "Chuyển khoản",
                                    PaymentMethod.Paypal       => "PayPal",
                                    PaymentMethod.Check        => "Séc",
                                    _ => "Không xác định"
                                })
                            </span>
                        </div>
                        @{
                            var payClass = Model.PaymentStatus switch {
                                PaymentStatus.Pending  => "text-warning",
                                PaymentStatus.Paid     => "text-success",
                                PaymentStatus.Refunded => "text-info",
                                _ => "text-secondary"
                            };
                            var payText = Model.PaymentStatus switch {
                                PaymentStatus.Pending  => "Chưa thanh toán",
                                PaymentStatus.Paid     => "Đã thanh toán",
                                PaymentStatus.Refunded => "Đã hoàn tiền",
                                _ => "Không xác định"
                            };
                        }
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Trạng thái TT:</span>
                            <span class="@payClass fw-bold">@payText</span>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                @if (Model.ShippingAddress != null)
                {
                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; overflow: hidden;">
                        <div style="height: 4px; background: linear-gradient(90deg,#81c408,#5a8a06);"></div>
                        <div class="card-header bg-white py-3">
                            <h5 class="mb-0 fw-bold"><i class="fa fa-truck me-2 text-success"></i>Địa chỉ giao hàng</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-1 fw-bold">@Model.ShippingAddress.FullName</p>
                            <p class="mb-1 text-muted">
                                <i class="fa fa-phone me-2"></i>@Model.ShippingAddress.Phone
                            </p>
                            <p class="mb-0 text-muted">
                                <i class="fa fa-map-marker-alt me-2"></i>@Model.ShippingAddress.FullAddress
                            </p>
                        </div>
                    </div>
                }

                <!-- Actions -->
                <div class="card border-0 shadow-sm" style="border-radius: 14px; overflow: hidden;">
                    <div style="height: 4px; background: linear-gradient(90deg,#81c408,#5a8a06);"></div>
                    <div class="card-body p-4">
                        <a asp-action="Lookup" class="btn btn-outline-success w-100 mb-2 fw-semibold" style="border-radius: 8px;">
                            <i class="fa fa-arrow-left me-2"></i>Tra cứu đơn khác
                        </a>
                        <div class="mt-3 p-3 rounded-3" style="background: #f0fdf4; border: 1px solid #d1fae5;">
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1 text-success"></i>
                                <a asp-controller="Account" asp-action="Login" class="text-success fw-semibold">Đăng nhập</a>
                                để quản lý đơn hàng đầy đủ hơn.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toast.show').forEach(function(toast) {
            setTimeout(function() {
                bootstrap.Toast.getOrCreateInstance(toast).hide();
            }, 5000);
        });
    </script>
}
